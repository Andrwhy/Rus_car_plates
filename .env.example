# Create a Telegram bot with @BotFather and put its token here.
TELEGRAM_BOT_TOKEN=replace_with_your_token

# Both models are local and intentionally excluded from Git.
MODEL_PATH=models/license_plate_detector.pt
CONFIDENCE=0.35

# Use `0` to run on the first NVIDIA GPU, or `cpu` when CUDA is unavailable.
DEVICE=cpu
ENABLE_OCR=true
